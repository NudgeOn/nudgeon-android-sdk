<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#12000000"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/token_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/token_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#12000000"
            android:padding="12dp"
            android:text="@string/token_initial"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />

        <EditText
            android:id="@+id/external_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/external_id_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/identify_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/identify" />

        <Button
            android:id="@+id/attributes_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_attributes" />

        <Button
            android:id="@+id/track_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/track_event" />

        <Button
            android:id="@+id/flush_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush" />

        <Button
            android:id="@+id/reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <Button
            android:id="@+id/permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/request_permission" />

        <Button
            android:id="@+id/token_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_token" />

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_status" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/opt_in_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/opt_in" />

            <Button
                android:id="@+id/opt_out_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/opt_out" />
        </LinearLayout>

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingBottom="32dp"
            android:text="@string/log_initial"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
